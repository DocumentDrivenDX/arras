      "name": "@documentdrivendx/arras-ui",
      "version": "0.6.5",
      "version_source": "pyproject.toml",
      "exports": {
        ".": {
          "runtime": "dist/index.js",
          "types": "dist/types/index.d.ts"
        },
        "./browser": {
          "runtime": "dist/browser.js",
          "types": "dist/types/browser/index.d.ts"
        },
        "./shell": {
          "runtime": "dist/shell.js",
          "types": "dist/types/shell/index.d.ts"
        },
        "./testkit": {
          "runtime": "dist/testkit.js",
          "types": "dist/types/testkit/index.d.ts"
        },
        "./testkit/host": {
          "runtime": "dist/testkit/host.js",
          "types": "dist/types/testkit/host.d.ts"
        },
        "./styles.css": {
          "style": "dist/styles.css"
        },
        "./package.json": {
          "metadata": "package.json"
        }
      },
      "peer_dependencies": {
        "react": {
          "version": "^19.3.0",
          "optional": false
        },
        "react-dom": {
          "version": "^19.3.0",
          "optional": false
