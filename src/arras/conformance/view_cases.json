{
 "version": 1,
 "module": "module.umf.json",
 "covers": [],
 "cases": [
  {
   "id": "view.defaults-without-a-view",
   "covers": [
    "US-067-AC1",
    "US-070-AC6"
   ],
   "description": "a document with no arras.view resolves to the derived defaults",
   "set": [],
   "expect": {
    "ok": true,
    "module": {
     "title": "catalog",
     "description": null
    },
    "types": {
     "UseCase": {
      "declared": false,
      "label": "Use case",
      "icon": "circle",
      "tone": "slate",
      "title": "{name}",
      "summary": null,
      "search": [
       "name",
       "code"
      ],
      "sections": [
       {
        "label": "Details",
        "properties": [
         "workArea"
        ],
        "collapsed": false
       }
      ],
      "pluralLabel": "Use cases"
     },
     "Solution": {
      "declared": false,
      "label": "Solution",
      "icon": "circle",
      "tone": "blue",
      "title": "{name}",
      "summary": null,
      "search": [
       "name",
       "code"
      ],
      "pluralLabel": "Solutions"
     }
    }
   }
  },
  {
   "id": "view.declared-resolves",
   "covers": [
    "US-070-AC1",
    "US-070-AC2"
   ],
   "description": "a declared view is merged over the defaults",
   "set": [
    {
     "at": [
      "vocabularies",
      "arras.view"
     ],
     "value": {
      "version": "0.1.0"
     }
    },
    {
     "at": [
      "modules",
      0,
      "extensions",
      "arras.view"
     ],
     "value": {
      "title": "Cases",
      "description": "Use cases and solutions"
     }
    },
    {
     "at": [
      "modules",
      0,
      "elements",
      0,
      "extensions",
      "arras.view"
     ],
     "value": {
      "label": "Work area",
      "icon": "scale",
      "tone": "violet",
      "title": "{name}[ ({code})]",
      "summary": "{workArea}",
      "sections": [
       {
        "label": "Where",
        "properties": [
         "workArea"
        ],
        "collapsed": true
       }
      ],
      "search": [
       "name"
      ],
      "pluralLabel": "Areas of work"
     }
    },
    {
     "at": [
      "modules",
      0,
      "elements",
      6,
      "extensions",
      "arras.view"
     ],
     "value": {
      "label": "Title",
      "format": "text"
     }
    }
   ],
   "expect": {
    "ok": true,
    "module": {
     "title": "Cases",
     "description": "Use cases and solutions"
    },
    "types": {
     "UseCase": {
      "declared": true,
      "label": "Work area",
      "icon": "scale",
      "tone": "violet",
      "title": "{name}[ ({code})]",
      "summary": "{workArea}",
      "search": [
       "name"
      ],
      "sections": [
       {
        "label": "Where",
        "properties": [
         "workArea"
        ],
        "collapsed": true
       }
      ],
      "pluralLabel": "Areas of work"
     },
     "Solution": {
      "declared": true,
      "label": "Solution",
      "icon": "circle",
      "tone": "blue",
      "pluralLabel": "Solutions"
     }
    }
   }
  },
