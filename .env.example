# Every key the MCP process (`python -m arras.mcp`) reads from the environment. Values here are
# placeholders or localhost-only: real handles and tokens are injected at deploy time and never
# committed. tests/test_config.py keeps this file and arras.mcp.config.KEYS in step.
#
# Dev-owned settings and module placement live in committed files, not here: config/default.toml
# and config/<ARRAS_ENV>.toml (see config/example.toml). The keys below are ops-owned, or a dev
# key an operator may override at deploy time during an incident.
#
# Ops-owned (no default; absent means the backend is not_configured or there is no identity)
# Also set per backend the host names: ARRAS_BACKEND_<NAME>_ENDPOINT, or in the ops file
# `[backends.<name>] endpoint = "..."` (the environment wins over the file).
ARRAS_ENV=
ARRAS_CONFIG_DIR=
ARRAS_OPS_FILE=
ARRAS_TOKEN_FILE=
ARRAS_TOKEN=
#
# Dev-owned (defaulted in the schema; an operator may override at deploy time during an incident)
ARRAS_USER_CLAIM=preferred_username,email,sub
ARRAS_LOG_LEVEL=INFO
ARRAS_DEV_SANDBOX=0
ARRAS_DEV_USER=alice
