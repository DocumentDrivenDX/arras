{
  "name": "arras-ui",
  "private": true,
  "version": "0.1.0",
  "description": "Arras interfaces: the Operator Console (FEAT-010), the Graph Browser (FEAT-011) and the shell that offers both (ADR-021, ADR-025), as a React component library and a standalone host.",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./browser": "./src/browser/index.ts",
    "./shell": "./src/shell/index.ts",
    "./styles.css": "./src/styles.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:embed": "vite build --config vite.embed.config.ts && node scripts/pack-runtime-assets.ts",
    "build:lib": "vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "pack:wheel": "node scripts/pack-wheel.ts",
    "test:packed-consumer": "node scripts/packed-consumer.mjs",
    "qualify:downstream-theme": "node scripts/qualify-downstream-theme.mjs",
    "qualify:downstream": "node scripts/run-downstream-qualification.mjs",
    "build:wheel": "npm run build:embed && npm run build:lib && npm run check:public-manifest && npm run check:css -- dist-lib/styles.css && npm run pack:wheel",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:all": "vitest run --config vitest.coverage.config.ts",
    "coverage": "vitest run --config vitest.coverage.config.ts --coverage",
    "e2e": "playwright test",
    "e2e:visual": "playwright test --project=visual",
    "e2e:visual:update": "playwright test --project=visual --update-snapshots",
    "check:umf": "node scripts/umf-schema-browser.ts",
    "check:css": "node scripts/check-scoped-css.ts",
    "check:externals": "node scripts/check-externals.ts dist-lib",
    "check:public-manifest": "node scripts/check-public-manifest.ts"
  },
  "dependencies": {
    "@documentdrivendx/umf-schema-browser": "2.0.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.104.0",
    "@vitejs/plugin-react": "^6.1.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2"
  },
  "peerDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0"
  },
  "peerDependenciesMeta": {
    "@axe-core/playwright": { "optional": true },
    "@playwright/test": { "optional": true }
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.1",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  },
  "license": "MIT OR Apache-2.0",
  "overrides": {
    "playwright-core": "1.63.0"
  }
}
